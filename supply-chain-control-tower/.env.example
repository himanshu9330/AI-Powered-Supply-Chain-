# =============================================
# AI-Powered Supply Chain Control Tower
# Environment Configuration
# =============================================

# --- PostgreSQL ---
POSTGRES_DB=supply_chain
POSTGRES_USER=sct_admin
POSTGRES_PASSWORD=sct_secret_2024

# --- Backend ---
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://sct_admin:sct_secret_2024@localhost:5432/supply_chain

# --- JWT ---
JWT_ACCESS_SECRET=your_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000

# --- Email (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# --- Frontend ---
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
